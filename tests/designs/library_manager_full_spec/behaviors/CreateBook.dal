behavior("CreateBook")

description("Creates a book with the given name.")

#============================
#       Participants
#============================
participant(name="book_name", role="BOOK_NAME")

#===============================
#  Modification to World State
#===============================
return(
    {
        book: "book"
    }
)

introduces(
    {
        name: "book"
        role: "BOOK"
    }
)

updateWorldState(name="book", role="BOOK")

#===========================
#     Narrative
#===========================
generate{
    {
        type: "success",
        sentence: f"Created a book with the name {book_name}.",
    }
}