design("add_book_to_basket")

behavior createBasket() {
    create(name=basket, type="list", role="basket", accepts="book")
    select getName
}

behavior getName() {
    create(name=name, type="string", role="name")
    getInput(name)
    set(worldState, ["name"], name)
    select createBook
}

behavior createBook() {
    get(name, worldState, ["name"])
    create(name=book, type="object", role="book")
    set(book, ["name"], name)
    remove(worldState, ["name"])
    select addBookToBasket
}

behavior addBookToBasket() {
    get(book, worldState, ["book"])
    get(basket, worldState, ["basket"])
    insert(basket, book, 0)
    set(basket, worldState, ["basket"])
    remove(worldState, ["book"])
    select getName
}

main {
    start(createBasket)
    run()
}